# Local JSON persistence is used by default; no AWS credentials required for local Replay.
USE_DYNAMODB=false
LOCAL_DATA_DIR=.local_data
AWS_REGION=us-east-1
# Strands Agents SDK drafts the proposal. ollama runs fully local; bedrock needs AWS credentials.
AGENT_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_ID=qwen3-vl:2b-instruct
AGENT_TIMEOUT_SECONDS=90
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_SECONDS=25
OPENMETEO_TIMEOUT_SECONDS=12
OPENMETEO_MAX_CONCURRENCY=4
SNS_TOPIC_ARN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
